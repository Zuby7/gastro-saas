# Headers for files served directly by the Workers static assets binding
# (issue #204). Responses generated by the Worker itself get their headers
# from next.config.ts instead; this file is not applied to them.

/*
  X-Content-Type-Options: nosniff

# Content-hashed build output: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
