# Copy to .env.local for local development (never commit real values -- .env*
# is hook-blocked, see CLAUDE.md "Security rules"). The values below match
# Supabase's well-known LOCAL DEV defaults printed by `supabase start`
# (see docs/decisions/assumptions.md) -- they only work against the local
# Docker stack and are not secrets. Real project values (staging/production)
# are provisioned separately once a real Supabase project exists (out of
# scope for ticket #3 -- explicit non-goal: no real cloud project).

# ---------------------------------------------------------------------------
# Supabase -- local stack (packages/database)
# ---------------------------------------------------------------------------

# Base URL of the local Supabase API gateway (see supabase/config.toml [api] port).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key -- safe for the browser, still governed by RLS.
# Local dev default only (from `supabase start` output); real Supabase
# projects issue their own value, never this one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key -- bypasses RLS entirely. SERVER-SIDE ONLY, never exposed
# to the browser, never prefixed with NEXT_PUBLIC_. Used only by trusted
# server-side handlers (e.g. guest checkout, Layer 0 -- see
# docs/security/tenant-isolation.md).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Direct Postgres connection string (used by the migration/CLI tooling, not
# by the app at request time). Local default matches supabase/config.toml [db] port.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWT secret used to sign/verify local Supabase auth tokens. Local dev
# default only -- a real Supabase project has its own, never this one.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ---------------------------------------------------------------------------
# Stripe Connect (Epic 7, ticket #23) -- TEST MODE ONLY
# ---------------------------------------------------------------------------

# Stripe secret key. MUST be a TEST MODE key (starts with sk_test_ -- a
# restricted test key rk_test_ also works). SERVER-SIDE ONLY, never exposed
# to the browser, never prefixed with NEXT_PUBLIC_.
# `apps/web/src/lib/stripe/client.ts` hard-refuses any key without the
# sk_test_/rk_test_ prefix -- this is a real enforced gate, not just a
# convention, per CLAUDE.md/.claude/rules/payments.md ("Stripe test mode
# only until the user explicitly authorizes production activation").
STRIPE_SECRET_KEY=sk_test_your_test_mode_secret_key

# Signing secret for the Stripe **Connect** webhook endpoint
# (/api/webhooks/stripe-connect), used to verify `account.updated` events.
# Get this from `stripe listen --events account.updated --forward-to
# localhost:3000/api/webhooks/stripe-connect` (Stripe CLI) for local dev, or
# the Dashboard's Connect webhook configuration -- test mode only. Separate
# from the eventual ticket #25 payment-event webhook secret (a different
# Stripe webhook endpoint).
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_test_mode_connect_webhook_secret

# Signing secret for the Stripe **payment events** webhook endpoint
# (/api/webhooks/stripe, ticket #25), used to verify
# checkout.session.completed / checkout.session.expired /
# payment_intent.payment_failed events arriving on the platform account
# (ADR-0002 destination charges). Deliberately a distinct Stripe webhook
# endpoint + signing secret from STRIPE_CONNECT_WEBHOOK_SECRET above -- get
# this from `stripe listen --events checkout.session.completed,checkout.session.expired,payment_intent.payment_failed
# --forward-to localhost:3000/api/webhooks/stripe` (Stripe CLI) for local
# dev, or the Dashboard's webhook configuration -- test mode only.
STRIPE_WEBHOOK_SECRET=whsec_your_test_mode_payments_webhook_secret
